# Copy this file to .env and put in your own value. .env is gitignored, never commit it.
# SQL Server wants 8+ characters with upper case, lower case and a number.
# Stick to letters and numbers so it is safe in a connection string.
MSSQL_SA_PASSWORD=ChangeMe_UseYourOwnStrongPassword1
# The port SQL Server shows up on your PC. Change it if 1433 is already taken.
SQL_PORT=1433
