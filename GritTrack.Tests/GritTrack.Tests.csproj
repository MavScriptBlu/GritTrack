<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- the MAUI app can't be loaded by a plain test project, so the files
       that have no phone code in them are pulled in directly and tested here.
       same code the app runs, no copies -->
  <ItemGroup>
    <Compile Include="..\GritTrack\Models\*.cs" Link="App\Models\%(Filename)%(Extension)" />
    <Compile Include="..\GritTrack\Services\Offline\*.cs" Link="App\Offline\%(Filename)%(Extension)" />
    <Compile Include="..\GritTrack\Services\Reminders\ReminderPlanner.cs" Link="App\Reminders\ReminderPlanner.cs" />
    <Compile Include="..\GritTrack\Services\Api\ApiExceptions.cs" Link="App\Api\ApiExceptions.cs" />
    <Compile Include="..\GritTrack\Services\ICourseRepository.cs" Link="App\ICourseRepository.cs" />
    <Compile Include="..\GritTrack\Services\AssignmentImportResult.cs" Link="App\AssignmentImportResult.cs" />
    <Compile Include="..\GritTrack\Services\GpaCalculatorService.cs" Link="App\GpaCalculatorService.cs" />
  </ItemGroup>

</Project>
