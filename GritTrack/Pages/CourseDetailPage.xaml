<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GritTrack.Controls"
             x:Class="GritTrack.Pages.CourseDetailPage"
             Title="Course Detail"
             BackgroundColor="#060606">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="GradientButterPeach" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#f2e3a6" Offset="0.0" />
            <GradientStop Color="#ffcfa6" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <!-- outer Grid so the "are you sure" card can float on top of
         everything else on the page instead of squeezing into the
         normal page layout -->
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding Course.CourseCode}" FontSize="14" TextColor="#ffcfa6" />
            <Label Text="{Binding Course.Name}" FontSize="28" FontAttributes="Bold" TextColor="#ece9e2" />
            <Label Text="{Binding Course.Instructor, StringFormat='Instructor: {0}'}" FontSize="14" TextColor="#b8b4a8"/>

            <BoxView HeightRequest="1" Color="#232323" Margin="0,10" />

            <Border Stroke="{StaticResource GradientButterPeach}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12,24,12,24"
                    Padding="16"
                    BackgroundColor="#0d0d0d">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Label Grid.Row="0" Grid.Column="0" Text="Credits" FontAttributes="Bold" TextColor="#ece9e2" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Course.Credits}" TextColor="#ece9e2" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Current Grade" FontAttributes="Bold" TextColor="#ece9e2" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Course.CurrentGrade}" TextColor="#ece9e2" />
                </Grid>
            </Border>

            <!-- DYNAMIC resource — see CourseListPage.xaml's heading comment.
                 Same AccentColor key, so this button matches whatever the
                 app's current GPA-status color is -->
            <Button Text="Edit Course"
                    Command="{Binding EditCommand}"
                    Margin="0,20,0,0"
                    BackgroundColor="{DynamicResource AccentColor}"
                    TextColor="#060606"
                    CornerRadius="24" />

            <Button Text="Drop This Course"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#f6adbf"
                    BorderColor="#f6adbf"
                    BorderWidth="1"
                    CornerRadius="24" />

            <Button Text="Back to Courses"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#b8b4a8"
                    BorderColor="#333"
                    BorderWidth="1"
                    CornerRadius="24" />

        </VerticalStackLayout>
    </ScrollView>

        <!-- ===== the "are you sure" card, same shared control used on
             CourseListPage and AddCoursePage — one control, one look,
             one place to fix if it ever needs to change ===== -->
        <controls:BluOSBottomSheet IsOpen="{Binding IsConfirmingDelete}"
                                    SheetTitle="Drop This Course?"
                                    CloseCommand="{Binding CancelDeleteCommand}">
            <controls:BluOSBottomSheet.SheetContent>
                <VerticalStackLayout Spacing="16">

                    <Label Text="{Binding Course.Name, StringFormat='Remove {0}? This can\'t be undone.'}"
                           FontFamily="ArchitectsDaughter"
                           FontSize="14"
                           TextColor="#b8b4a8"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Drop It"
                            Command="{Binding ConfirmDeleteCommand}"
                            BackgroundColor="#f6adbf"
                            TextColor="#060606"
                            CornerRadius="24"
                            HeightRequest="48" />

                    <Button Text="Cancel"
                            Command="{Binding CancelDeleteCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#b8b4a8"
                            BorderColor="#333"
                            BorderWidth="1"
                            CornerRadius="24"
                            HeightRequest="48" />

                </VerticalStackLayout>
            </controls:BluOSBottomSheet.SheetContent>
        </controls:BluOSBottomSheet>

    </Grid>
</ContentPage>
