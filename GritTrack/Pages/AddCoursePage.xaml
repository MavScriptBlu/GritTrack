<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GritTrack.Pages.AddCoursePage"
             Title="{Binding Title}"
             BackgroundColor="#060606">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="GradientPinkLavender" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#f6adbf" Offset="0.0" />
            <GradientStop Color="#c3b0f2" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding Title}"
                   FontFamily="KalamBold"
                   FontSize="28"
                   TextColor="lightseagreen"
                   TextTransform="Uppercase"
                   CharacterSpacing="1" />

            <!-- validation feedback — only shows up when Save actually rejects
                 something, so tapping Save always gives you SOME response
                 instead of just quietly doing nothing -->
            <Label Text="{Binding ValidationMessage}"
                   IsVisible="{Binding HasValidationMessage}"
                   FontFamily="ArchitectsDaughter"
                   FontSize="13"
                   TextColor="#f6adbf" />

            <Border Stroke="{StaticResource GradientPinkLavender}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12,24,12,24"
                    Padding="16"
                    BackgroundColor="#0d0d0d">
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Course Name *" FontFamily="ArchitectsDaughter" FontSize="12" TextColor="#b8b4a8" />
                        <Entry Text="{Binding Name}" TextColor="#ece9e2" PlaceholderColor="#666" Placeholder="e.g. Web Development II" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Course Code (optional)" FontFamily="ArchitectsDaughter" FontSize="12" TextColor="#b8b4a8" />
                        <Entry Text="{Binding CourseCode}" TextColor="#ece9e2" PlaceholderColor="#666" Placeholder="e.g. CS-160" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Instructor (optional)" FontFamily="ArchitectsDaughter" FontSize="12" TextColor="#b8b4a8" />
                        <Entry Text="{Binding Instructor}" TextColor="#ece9e2" PlaceholderColor="#666" Placeholder="e.g. Staff" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Credits (optional)" FontFamily="ArchitectsDaughter" FontSize="12" TextColor="#b8b4a8" />
                            <Entry Text="{Binding Credits}" Keyboard="Numeric" TextColor="#ece9e2" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Grade (optional)" FontFamily="ArchitectsDaughter" FontSize="12" TextColor="#b8b4a8" />
                            <Picker ItemsSource="{Binding LetterGrades}"
                                    SelectedItem="{Binding LetterGrade}"
                                    TextColor="#ece9e2"
                                    TitleColor="#ece9e2" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="lightseagreen"
                    TextColor="#060606"
                    CornerRadius="24"
                    Margin="0,10,0,0" />

            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#b8b4a8"
                    BorderColor="#333"
                    BorderWidth="1"
                    CornerRadius="24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
