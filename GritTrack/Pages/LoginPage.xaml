<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GritTrack.Controls"
             xmlns:pagemodels="clr-namespace:GritTrack.PageModels"
             x:Class="GritTrack.Pages.LoginPage"
             x:DataType="pagemodels:LoginPageModel"
             Title="Sign In"
             BackgroundColor="#060606">

    <ContentPage.Resources>
        <LinearGradientBrush x:Key="GradientPinkLavender" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#f6adbf" Offset="0.0" />
            <GradientStop Color="#c3b0f2" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <!-- the top bar's back arrow runs the same Cancel command as the Cancel
         button, so backing out always tells the waiting save/delete -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}" />
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Sign In"
                   FontFamily="KalamBold"
                   FontSize="28"
                   TextColor="{DynamicResource AccentColor}"
                   TextTransform="Uppercase"
                   CharacterSpacing="1"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Looking at courses is open to everyone. Adding, editing and dropping them needs a login."
                   FontFamily="ArchitectsDaughter"
                   FontSize="14"
                   TextColor="#b8b4a8" />

            <Border Stroke="{StaticResource GradientPinkLavender}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12,24,12,24"
                    Padding="16"
                    BackgroundColor="#0d0d0d">
                <VerticalStackLayout Spacing="12">

                    <controls:ValidatedField LabelText="User Name"
                                             Text="{Binding UserName, Mode=TwoWay}"
                                             ErrorText="{Binding UserNameError}"
                                             Placeholder="demo user name"
                                             ReturnType="Next" />

                    <controls:ValidatedField LabelText="Password"
                                             Text="{Binding Password, Mode=TwoWay}"
                                             ErrorText="{Binding PasswordError}"
                                             IsPassword="True"
                                             ReturnType="Done"
                                             ReturnCommand="{Binding SignInCommand}" />

                </VerticalStackLayout>
            </Border>

            <!-- loading state -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource AccentColor}"
                               SemanticProperties.Description="Signing in" />

            <!-- error state: wrong password or server not running. big card right
                 above Sign In so it's where your eyes already are. the pink boxes
                 above cover the "you left it empty" case -->
            <controls:ErrorBanner IsVisible="{Binding HasError}"
                                  Title="Couldn't sign in"
                                  Message="{Binding ErrorMessage}"
                                  ActionText="Try Again"
                                  ActionCommand="{Binding SignInCommand}"
                                  IsActionEnabled="{Binding IsNotBusy}"
                                  Margin="0,10,0,0" />

            <Button Text="Sign In"
                    Command="{Binding SignInCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    BackgroundColor="{DynamicResource AccentColor}"
                    TextColor="#060606"
                    CornerRadius="24"
                    Margin="0,4,0,0" />

            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#b8b4a8"
                    BorderColor="#333"
                    BorderWidth="1"
                    CornerRadius="24" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
