diff --git a/GritTrack/Controls/ErrorBanner.xaml b/GritTrack/Controls/ErrorBanner.xaml
new file mode 100644
index 0000000..4910119
--- /dev/null
+++ b/GritTrack/Controls/ErrorBanner.xaml
@@ -0,0 +1,41 @@
+<?xml version="1.0" encoding="utf-8" ?>
+<!-- the big "something went wrong" card. a loud title, the message at a
+     size you can actually read, and an optional button (Try Again).
+     pages show or hide it with IsVisible -->
+<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
+             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
+             x:Class="GritTrack.Controls.ErrorBanner">
+
+    <Border Stroke="#f6adbf"
+            StrokeThickness="2"
+            StrokeShape="RoundRectangle 16,4,16,4"
+            Padding="18"
+            BackgroundColor="#1f1014">
+
+        <VerticalStackLayout Spacing="10">
+
+            <Label x:Name="TitleLabel"
+                   FontFamily="KalamBold"
+                   FontSize="22"
+                   TextColor="#f6adbf"
+                   SemanticProperties.HeadingLevel="Level2" />
+
+            <Label x:Name="MessageLabel"
+                   FontFamily="ArchitectsDaughter"
+                   FontSize="16"
+                   TextColor="#ece9e2" />
+
+            <Button x:Name="ActionButton"
+                    IsVisible="False"
+                    BackgroundColor="Transparent"
+                    TextColor="#f6adbf"
+                    BorderColor="#f6adbf"
+                    BorderWidth="1"
+                    CornerRadius="24"
+                    FontFamily="KalamBold"
+                    HeightRequest="44"
+                    MinimumWidthRequest="44" />
+
+        </VerticalStackLayout>
+    </Border>
+</ContentView>
diff --git a/GritTrack/Controls/ErrorBanner.xaml.cs b/GritTrack/Controls/ErrorBanner.xaml.cs
new file mode 100644
index 0000000..9d4e9c7
--- /dev/null
+++ b/GritTrack/Controls/ErrorBanner.xaml.cs
@@ -0,0 +1,112 @@
+using System.Windows.Input;
+
+namespace GritTrack.Controls
+{
+    // the shared big error card. Title + Message always, plus an action button
+    // (like Try Again) only when the page gives it ActionText and ActionCommand
+    public partial class ErrorBanner : ContentView
+    {
+        public ErrorBanner()
+        {
+            InitializeComponent();
+        }
+
+        public static readonly BindableProperty TitleProperty =
+            BindableProperty.Create(
+                nameof(Title),
+                typeof(string),
+                typeof(ErrorBanner),
+                string.Empty,
+                propertyChanged: OnTitleChanged);
+
+        public string Title
+        {
+            get => (string)GetValue(TitleProperty);
+            set => SetValue(TitleProperty, value);
+        }
+
+        private static void OnTitleChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ErrorBanner banner)
+                banner.TitleLabel.Text = (string)newValue;
+        }
+
+        public static readonly BindableProperty MessageProperty =
+            BindableProperty.Create(
+                nameof(Message),
+                typeof(string),
+                typeof(ErrorBanner),
+                string.Empty,
+                propertyChanged: OnMessageChanged);
+
+        public string Message
+        {
+            get => (string)GetValue(MessageProperty);
+            set => SetValue(MessageProperty, value);
+        }
+
+        private static void OnMessageChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ErrorBanner banner)
+            {
+                banner.MessageLabel.Text = (string)newValue;
+                SemanticProperties.SetDescription(banner.MessageLabel, $"{banner.Title}. {newValue}");
+            }
+        }
+
+        public static readonly BindableProperty ActionTextProperty =
+            BindableProperty.Create(
+                nameof(ActionText),
+                typeof(string),
+                typeof(ErrorBanner),
+                string.Empty,
+                propertyChanged: OnActionChanged);
+
+        public string ActionText
+        {
+            get => (string)GetValue(ActionTextProperty);
+            set => SetValue(ActionTextProperty, value);
+        }
+
+        public static readonly BindableProperty ActionCommandProperty =
+            BindableProperty.Create(
+                nameof(ActionCommand),
+                typeof(ICommand),
+                typeof(ErrorBanner),
+                null,
+                propertyChanged: OnActionChanged);
+
+        public ICommand? ActionCommand
+        {
+            get => (ICommand?)GetValue(ActionCommandProperty);
+            set => SetValue(ActionCommandProperty, value);
+        }
+
+        // false while a retry is already running, so you can't double tap it
+        public static readonly BindableProperty IsActionEnabledProperty =
+            BindableProperty.Create(
+                nameof(IsActionEnabled),
+                typeof(bool),
+                typeof(ErrorBanner),
+                true,
+                propertyChanged: OnActionChanged);
+
+        public bool IsActionEnabled
+        {
+            get => (bool)GetValue(IsActionEnabledProperty);
+            set => SetValue(IsActionEnabledProperty, value);
+        }
+
+        // text, command and enabled all land here, the button just follows them
+        private static void OnActionChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is not ErrorBanner banner)
+                return;
+
+            banner.ActionButton.Text = banner.ActionText;
+            banner.ActionButton.Command = banner.ActionCommand;
+            banner.ActionButton.IsEnabled = banner.IsActionEnabled;
+            banner.ActionButton.IsVisible = !string.IsNullOrEmpty(banner.ActionText) && banner.ActionCommand is not null;
+        }
+    }
+}
diff --git a/GritTrack/Controls/ValidatedField.xaml b/GritTrack/Controls/ValidatedField.xaml
new file mode 100644
index 0000000..41eab50
--- /dev/null
+++ b/GritTrack/Controls/ValidatedField.xaml
@@ -0,0 +1,39 @@
+<?xml version="1.0" encoding="utf-8" ?>
+<!-- one text box with its label on top and its own error line underneath.
+     goes blush pink (thick outline + tint) the second ErrorText has
+     something in it, so you can see WHICH box is the problem. every form
+     uses this instead of a bare Entry -->
+<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
+             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
+             x:Class="GritTrack.Controls.ValidatedField">
+
+    <VerticalStackLayout Spacing="4">
+
+        <Label x:Name="FieldLabel"
+               FontFamily="ArchitectsDaughter"
+               FontSize="12"
+               TextColor="#b8b4a8" />
+
+        <Border x:Name="FieldBorder"
+                Stroke="#333333"
+                StrokeThickness="1"
+                StrokeShape="RoundRectangle 12,4,12,4"
+                Padding="10,0"
+                BackgroundColor="Transparent">
+            <Entry x:Name="FieldEntry"
+                   TextColor="#ece9e2"
+                   PlaceholderColor="#666666"
+                   TextChanged="OnEntryTextChanged"
+                   Focused="OnEntryFocused"
+                   Unfocused="OnEntryUnfocused" />
+        </Border>
+
+        <!-- big enough to actually read, right under the box it's about -->
+        <Label x:Name="ErrorLabel"
+               IsVisible="False"
+               FontFamily="ArchitectsDaughter"
+               FontSize="14"
+               TextColor="#f6adbf" />
+
+    </VerticalStackLayout>
+</ContentView>
diff --git a/GritTrack/Controls/ValidatedField.xaml.cs b/GritTrack/Controls/ValidatedField.xaml.cs
new file mode 100644
index 0000000..eaeed0c
--- /dev/null
+++ b/GritTrack/Controls/ValidatedField.xaml.cs
@@ -0,0 +1,255 @@
+using System.Windows.Input;
+
+namespace GritTrack.Controls
+{
+    // label + text box + error line, all in one. the page hands it a LabelText,
+    // a Text to bind to and an ErrorText. empty ErrorText = happy box,
+    // anything in it = pink outline and the message underneath
+    public partial class ValidatedField : ContentView
+    {
+        private static readonly Color ErrorColor = Color.FromArgb("#f6adbf");
+        private static readonly Color ErrorTint = Color.FromArgb("#1f1014");
+        private static readonly Color RestingColor = Color.FromArgb("#333333");
+        private static readonly Color FallbackFocusColor = Color.FromArgb("#9fe0bd");
+
+        private bool _isFocused;
+
+        public ValidatedField()
+        {
+            InitializeComponent();
+        }
+
+        // the small label above the box
+        public static readonly BindableProperty LabelTextProperty =
+            BindableProperty.Create(
+                nameof(LabelText),
+                typeof(string),
+                typeof(ValidatedField),
+                string.Empty,
+                propertyChanged: OnLabelTextChanged);
+
+        public string LabelText
+        {
+            get => (string)GetValue(LabelTextProperty);
+            set => SetValue(LabelTextProperty, value);
+        }
+
+        private static void OnLabelTextChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+            {
+                field.FieldLabel.Text = (string)newValue;
+                field.RefreshLook();
+            }
+        }
+
+        // what the user typed. two way, so the PageModel property stays in sync
+        public static readonly BindableProperty TextProperty =
+            BindableProperty.Create(
+                nameof(Text),
+                typeof(string),
+                typeof(ValidatedField),
+                string.Empty,
+                BindingMode.TwoWay,
+                propertyChanged: OnTextChanged);
+
+        public string Text
+        {
+            get => (string)GetValue(TextProperty);
+            set => SetValue(TextProperty, value);
+        }
+
+        private static void OnTextChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+            {
+                var newText = (string?)newValue ?? string.Empty;
+                if ((field.FieldEntry.Text ?? string.Empty) != newText)
+                    field.FieldEntry.Text = newText;
+            }
+        }
+
+        private void OnEntryTextChanged(object? sender, TextChangedEventArgs e)
+        {
+            Text = e.NewTextValue ?? string.Empty;
+        }
+
+        public static readonly BindableProperty PlaceholderProperty =
+            BindableProperty.Create(
+                nameof(Placeholder),
+                typeof(string),
+                typeof(ValidatedField),
+                string.Empty,
+                propertyChanged: OnPlaceholderChanged);
+
+        public string Placeholder
+        {
+            get => (string)GetValue(PlaceholderProperty);
+            set => SetValue(PlaceholderProperty, value);
+        }
+
+        private static void OnPlaceholderChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+                field.FieldEntry.Placeholder = (string)newValue;
+        }
+
+        // what's wrong with this box. empty means nothing is wrong
+        public static readonly BindableProperty ErrorTextProperty =
+            BindableProperty.Create(
+                nameof(ErrorText),
+                typeof(string),
+                typeof(ValidatedField),
+                string.Empty,
+                propertyChanged: OnErrorTextChanged);
+
+        public string ErrorText
+        {
+            get => (string)GetValue(ErrorTextProperty);
+            set => SetValue(ErrorTextProperty, value);
+        }
+
+        private static void OnErrorTextChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+                field.RefreshLook();
+        }
+
+        public static readonly BindableProperty KeyboardProperty =
+            BindableProperty.Create(
+                nameof(Keyboard),
+                typeof(Keyboard),
+                typeof(ValidatedField),
+                Keyboard.Default,
+                propertyChanged: OnKeyboardChanged);
+
+        public Keyboard Keyboard
+        {
+            get => (Keyboard)GetValue(KeyboardProperty);
+            set => SetValue(KeyboardProperty, value);
+        }
+
+        private static void OnKeyboardChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+                field.FieldEntry.Keyboard = (Keyboard?)newValue ?? Keyboard.Default;
+        }
+
+        public static readonly BindableProperty IsPasswordProperty =
+            BindableProperty.Create(
+                nameof(IsPassword),
+                typeof(bool),
+                typeof(ValidatedField),
+                false,
+                propertyChanged: OnIsPasswordChanged);
+
+        public bool IsPassword
+        {
+            get => (bool)GetValue(IsPasswordProperty);
+            set => SetValue(IsPasswordProperty, value);
+        }
+
+        private static void OnIsPasswordChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+                field.FieldEntry.IsPassword = (bool)newValue;
+        }
+
+        public static readonly BindableProperty ReturnTypeProperty =
+            BindableProperty.Create(
+                nameof(ReturnType),
+                typeof(ReturnType),
+                typeof(ValidatedField),
+                ReturnType.Default,
+                propertyChanged: OnReturnTypeChanged);
+
+        public ReturnType ReturnType
+        {
+            get => (ReturnType)GetValue(ReturnTypeProperty);
+            set => SetValue(ReturnTypeProperty, value);
+        }
+
+        private static void OnReturnTypeChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+                field.FieldEntry.ReturnType = (ReturnType)newValue;
+        }
+
+        // runs when the user hits Enter / Done on the keyboard
+        public static readonly BindableProperty ReturnCommandProperty =
+            BindableProperty.Create(
+                nameof(ReturnCommand),
+                typeof(ICommand),
+                typeof(ValidatedField),
+                null,
+                propertyChanged: OnReturnCommandChanged);
+
+        public ICommand? ReturnCommand
+        {
+            get => (ICommand?)GetValue(ReturnCommandProperty);
+            set => SetValue(ReturnCommandProperty, value);
+        }
+
+        private static void OnReturnCommandChanged(BindableObject bindable, object oldValue, object newValue)
+        {
+            if (bindable is ValidatedField field)
+                field.FieldEntry.ReturnCommand = newValue as ICommand;
+        }
+
+        private void OnEntryFocused(object? sender, FocusEventArgs e)
+        {
+            _isFocused = true;
+            RefreshLook();
+        }
+
+        private void OnEntryUnfocused(object? sender, FocusEventArgs e)
+        {
+            _isFocused = false;
+            RefreshLook();
+        }
+
+        // one place that decides how the box looks:
+        // error = thick pink + tint, focused = thick accent, otherwise quiet gray
+        private void RefreshLook()
+        {
+            var hasError = !string.IsNullOrEmpty(ErrorText);
+
+            ErrorLabel.Text = ErrorText ?? string.Empty;
+            ErrorLabel.IsVisible = hasError;
+
+            if (hasError)
+            {
+                FieldBorder.Stroke = new SolidColorBrush(ErrorColor);
+                FieldBorder.StrokeThickness = 2;
+                FieldBorder.BackgroundColor = ErrorTint;
+            }
+            else if (_isFocused)
+            {
+                FieldBorder.Stroke = new SolidColorBrush(GetFocusColor());
+                FieldBorder.StrokeThickness = 2;
+                FieldBorder.BackgroundColor = Colors.Transparent;
+            }
+            else
+            {
+                FieldBorder.Stroke = new SolidColorBrush(RestingColor);
+                FieldBorder.StrokeThickness = 1;
+                FieldBorder.BackgroundColor = Colors.Transparent;
+            }
+
+            // screen readers get the problem along with the field name
+            SemanticProperties.SetDescription(
+                FieldEntry,
+                hasError ? $"{LabelText}. {ErrorText}" : LabelText);
+        }
+
+        // AccentColor is rewritten by ThemeService as the GPA status changes,
+        // so read it fresh each time instead of caching it
+        private static Color GetFocusColor()
+        {
+            if (Application.Current?.Resources.TryGetValue("AccentColor", out var accent) == true && accent is Color accentColor)
+                return accentColor;
+
+            return FallbackFocusColor;
+        }
+    }
+}
