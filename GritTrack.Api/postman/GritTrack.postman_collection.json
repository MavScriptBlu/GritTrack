{
  "info": {
    "_postman_id": "b6eeddcc-8699-588e-8f49-ac5610d66ab4",
    "name": "GritTrack API",
    "description": "Runs against GritTrack.Api with auth ON or OFF: pick the matching environment (GritTrack - Auth ON / GritTrack - Auth OFF) and run the whole collection in the Collection Runner. Every request is green in both modes. The only things that change with the auth switch: login (404 when auth is off) and writes without a token (401 when auth is on). Auth ON needs the demoPassword environment value (the same one you set with dotnet user-secrets). It creates its own test data and deletes it, so it passes however many times in a row.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// adds the login token to every write (POST/PUT/DELETE). reads need none.",
          "// a request that sets its own Authorization header (the bad-token one) is left alone,",
          "// and the (no token) ones go without on purpose.",
          "const token = pm.environment.get('token');",
          "const isWrite = !['GET', 'HEAD'].includes(pm.request.method);",
          "const goesWithoutToken = pm.info.requestName.includes('(no token)');",
          "if (isWrite && token && !goesWithoutToken && !pm.request.headers.has('Authorization')) {",
          "  pm.request.headers.add({ key: 'Authorization', value: 'Bearer ' + token });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:49227"
    },
    {
      "key": "authEnabled",
      "value": "true"
    },
    {
      "key": "demoUserName",
      "value": "demo"
    },
    {
      "key": "courseCodeA",
      "value": "PMTST-1"
    },
    {
      "key": "courseCodeB",
      "value": "PMTST-2"
    },
    {
      "key": "courseIdA",
      "value": ""
    },
    {
      "key": "courseIdB",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Public reads (no login needed)",
      "item": [
        {
          "name": "Get all courses (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/courses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response is a list', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all courses filtered by grade (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/courses?grade=B+"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('every result matches the filter', () => pm.response.json().forEach(c => pm.expect(c.currentGrade.toUpperCase()).to.eql('B+')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get course by id - not found (404)",
          "request": {
