    {
      "name": "2. Login",
      "item": [
        {
          "name": "Login - wrong password (401, or 404 when auth is off)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{demoUserName}}\",\n  \"password\": \"this-is-not-the-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('token'); // every run starts logged out"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test(authOn ? 'status is 401 (auth on)' : 'status is 404 (auth off)', () => pm.response.to.have.status(authOn ? 401 : 404));",
                  "pm.test('no token handed out', () => pm.expect(pm.response.json()).to.not.have.property('token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - missing fields (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('says which fields', () => pm.expect(pm.response.json().errors).to.have.property('userName'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - correct password (200, or 404 when auth is off)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{demoUserName}}\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test(authOn ? 'status is 200 (auth on)' : 'status is 404 (auth off)', () => pm.response.to.have.status(authOn ? 200 : 404));",
                  "if (authOn) {",
                  "  const body = pm.response.json();",
                  "  pm.test('got a token that expires in the future', () => {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(new Date(body.expiresAtUtc).getTime()).to.be.above(Date.now());",
                  "  });",
                  "  pm.environment.set('token', body.token); // later writes use this",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Writes without a token",
      "item": [
        {
          "name": "Reset - delete test courses left from an earlier run",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/courses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const leftovers = pm.response.json().filter(c => ['PMTST-1', 'PMTST-2', 'PMNOTK-1', 'PMBAD-1'].includes(c.courseCode.toUpperCase()));",
                  "const headers = pm.environment.get('token') ? { Authorization: 'Bearer ' + pm.environment.get('token') } : {};",
                  "leftovers.forEach(c => pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/courses/' + c.id, method: 'DELETE', header: headers }));",
                  "pm.test('test data cleared (' + leftovers.length + ' leftovers removed)', () => pm.expect(true).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create course (no token) - 401, or 201 when auth is off",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
