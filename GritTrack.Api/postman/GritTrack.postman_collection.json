            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Intro to Databases\",\n  \"courseCode\": \"PMNOTK-1\",\n  \"instructor\": \"Staff\",\n  \"credits\": 3,\n  \"currentGrade\": \"B+\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const authOn = pm.variables.get('authEnabled') === 'true';",
                  "pm.test(authOn ? 'status is 401 (auth on)' : 'status is 201 (auth off)', () => pm.response.to.have.status(authOn ? 401 : 201));",
                  "pm.test(authOn ? 'asks for a Bearer token' : 'course really was created', () => {",
                  "  if (authOn) pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
                  "  else pm.expect(pm.response.json().courseCode).to.eql('PMNOTK-1');",
                  "});",
                  "if (!authOn && pm.response.code === 201) {",
                  "  pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/courses/' + pm.response.json().id, method: 'DELETE' });",
                  "}"
                ]
              }
            }
          ]
